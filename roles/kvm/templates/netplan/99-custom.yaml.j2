network:
  version: 2
  ethernets:
    {{network.interface_name}}:
      dhcp4: false
  bridges:
    br0:
      interfaces:
        - {{network.interface_name}}
      dhcp4: false
      addresses:
        - 10.10.10.101/24
      gateway4: 10.10.10.1
      nameservers:
        addresses:
          - 10.10.10.1
      parameters:
        forward-delay: 0
        stp: false