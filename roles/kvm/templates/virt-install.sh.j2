#/bin/bash

virt-install \
  --connect=qemu:///system \
  --import \
  --memory {{ parent_item.memory }} \
  --vcpus {{ parent_item.vcpus }} \
  --network bridge=br0 \
  --name {{ parent_item.instance_id }} \
  --disk {{images_directory}}/{{ parent_item.instance_id }}.{{ parent_item.image_format }},device=disk,bus=virtio,format={{ parent_item.image_format }} \
  --disk {{images_directory}}/isos/cloud-init/{{parent_item.instance_id}}-seed.iso,device=cdrom \
  --os-variant {{parent_item.os_variant}} \
  --virt-type kvm \
{% if parent_item.noautoconsole is defined and parent_item.noautoconsole is sameas true %}
  --noautoconsole \
{% endif %}
{% if parent_item.disable_autostart is not defined or parent_item.disable_autostart is not sameas true %}
  --autostart \
{% endif %}
{% if parent_item.passthrough_gpu is defined and parent_item.passthrough_gpu is sameas true %}
  --machine q35 \
  --host-device=pci_0000_03_00_0 \
  --host-device=pci_0000_03_00_1 \
{% endif %}
  --graphics none